{
  "manifest_version": 3,
  "name": "Mistral Chat — repli des messages longs",
  "version": "1.0.0",
  "description": "Replie les messages trop longs sur chat.mistral.ai derrière un bouton « Afficher plus », comme sur Claude. Hauteur limite configurable.",
  "author": "fracorbas",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.mistral.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_view": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mistral-message-collapser@fracorbas",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
